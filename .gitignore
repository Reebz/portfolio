# OS
.DS_Store
thumbs.db
# macOS Finder duplicates — appear when iCloud Drive / Finder copies
# files mid-session (typically named `foo 2.ext`, `foo 3.ext`, etc.).
# Untracked and noisy in `git status`; never commit them.
* [2-9].*
*\ [2-9].*

# Editor / IDE
*.swp
.vscode/
.idea/

# Node / build artifacts
node_modules/
dist/
build/
coverage/
.cache/

# Test output
test-results/
playwright-report/

# Logs
*.log

# Environment / secrets
.env
.env.*
*.pem
*.key

# Local-only docs (plans, brainstorms, notes) — except shared runbooks
docs/*
!docs/runbooks/

# Agent / assistant metadata (not for public repos)
.claude/
.serena/
mempalace.yaml
